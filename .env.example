NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:notes@localhost:5432/notes
# At least 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=
# Every OAuth client whose ID tokens the API accepts, comma-separated: the web client, then any mobile ones.
# Create the web client in the Google Cloud console (see README.md); it ends in .apps.googleusercontent.com.
GOOGLE_CLIENT_IDS=1234567890-web.apps.googleusercontent.com
# The browser origins allowed to call the API, comma-separated: here the page in web/.
CORS_ORIGINS=http://localhost:5173
# Google's signing keys. Leave it unset outside the tests.
# GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# `npx @nestjs/observe link` adds OBSERVE_APP_KEY and OBSERVE_APP_SECRET here.
